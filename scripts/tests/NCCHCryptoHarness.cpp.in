namespace FileUtil {
std::map<std::string,std::shared_ptr<std::vector<u8>>> fixtures;
constexpr u32 MakeMagic(char a,char b,char c,char d){return u32(a)|(u32(b)<<8)|(u32(c)<<16)|(u32(d)<<24);}
enum class UserPath {LoadDir,SDMCDir};
std::string GetUserPath(UserPath){return "/no-override/";}
bool Exists(const std::string&){return false;}
bool IsDirectory(const std::string&){return false;}
struct IOType {bool HasCompressedType(){return false;}};
class IOFileBase {
protected:
 std::shared_ptr<std::vector<u8>> data; size_t start=0,size=0,pos=0;
public:
 IOFileBase()=default;
 IOFileBase(std::shared_ptr<std::vector<u8>> d,size_t s,size_t n):data(d),start(s),size(n){}
 virtual ~IOFileBase()=default;
 bool IsOpen()const{return bool(data);}
 explicit operator bool()const{return IsOpen();}
 size_t GetSize()const{return size;}
 IOType GetType()const{return {};}
 size_t ReadAtBytes(void* out,size_t n,size_t off){if(!data||off>=size)return 0;n=std::min(n,size-off);std::memcpy(out,data->data()+start+off,n);return n;}
 template<class T> size_t ReadAtArray(T* p,size_t n,size_t off){return ReadAtBytes(p,n*sizeof(T),off);}
 size_t ReadBytes(void* out,size_t n){auto read=ReadAtBytes(out,n,pos);pos+=read;return read;}
 bool Seek(s64 off,int origin){if(off<0)return false;pos=(origin==SEEK_CUR?pos:0)+off;return pos<=size;}
 std::unique_ptr<IOFileBase> OpenCopy()const{return std::make_unique<IOFileBase>(data,start,size);}
 friend class SubIOFile;
};
class IOFile:public IOFileBase {public:IOFile(const std::string& path,const char*) {auto it=fixtures.find(path);if(it!=fixtures.end()){data=it->second;size=data->size();}}};
class SubIOFile:public IOFileBase {public:SubIOFile(std::unique_ptr<IOFileBase> f,size_t off,size_t n) {if(f&&off<=f->size&&n<=f->size-off){data=f->data;start=f->start+off;size=n;}}};
}
namespace HW::AES {
using AESKey=std::array<u8,16>;
enum KeySlotID {NCCHSecure1=0x2C,NCCHSecure2=0x25,NCCHSecure3=0x18,NCCHSecure4=0x1B};
std::array<std::optional<AESKey>,64> xs,ys;
AESKey generator;
void InitKeys(){}
void SetKeyY(size_t slot,const AESKey& key){ys[slot]=key;}
bool IsNormalKeyAvailable(size_t slot){return xs[slot].has_value()&&ys[slot].has_value();}
AESKey GetNormalKey(size_t slot);
}
// ACTUAL_ARITHMETIC
namespace HW::AES { AESKey GetNormalKey(size_t slot){if(!IsNormalKeyAvailable(slot))return {};return Lrot128(Add128(Xor128(Lrot128(*xs[slot],2),*ys[slot]),generator),87);} }
