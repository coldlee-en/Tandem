namespace FileSys {
std::optional<std::array<u8,16>> titleSeed;
std::optional<std::array<u8,16>> GetSeed(u64){return titleSeed;}
static const int kMaxSections=8,kBlockSize=0x200;
class RomFSReader {public:virtual ~RomFSReader()=default;virtual size_t ReadFile(size_t,size_t,u8*)=0;virtual size_t GetSize()const=0;};
class DirectRomFSReader:public RomFSReader {
 std::unique_ptr<FileUtil::IOFileBase> file;
 bool is_encrypted=false;
 std::array<u8,16> key{},ctr{};
 u64 crypto_offset=0;
 static constexpr size_t cache_line_size=8192,cache_line_count=16;
 Common::StaticLRUCache<size_t,std::array<u8,cache_line_size>,cache_line_count> cache;
 size_t OffsetToPage(size_t o){return Common::AlignDown<size_t>(o,cache_line_size);}
 std::vector<std::pair<size_t,size_t>> BreakupRead(size_t,size_t);
public:
 DirectRomFSReader(std::unique_ptr<FileUtil::IOFileBase> f):file(std::move(f)){}
 DirectRomFSReader(std::unique_ptr<FileUtil::IOFileBase> f,const std::array<u8,16>& k,const std::array<u8,16>& c,u64 o):file(std::move(f)),is_encrypted(true),key(k),ctr(c),crypto_offset(o){}
 size_t GetSize()const override{return file->GetSize();}
 size_t ReadFile(size_t,size_t,u8*) override;
};
class LayeredFS:public RomFSReader {public:LayeredFS(std::shared_ptr<RomFSReader>,std::string,std::string){} size_t ReadFile(size_t,size_t,u8*)override{return 0;}size_t GetSize()const override{return 0;}};
// ACTUAL_CLASS
NCCHContainer::NCCHContainer(const std::string& path,u32,u32 part):partition(part),filepath(path){file=std::make_unique<FileUtil::IOFile>(path,"rb");}
Loader::ResultStatus NCCHContainer::LoadOverrides(){return Loader::ResultStatus::Success;}
Loader::ResultStatus NCCHContainer::LoadOverrideExeFSSection(const char*,std::vector<u8>&){return Loader::ResultStatus::ErrorNotUsed;}
Loader::ResultStatus NCCHContainer::ReadOverrideRomFS(std::shared_ptr<RomFSReader>&){return Loader::ResultStatus::ErrorNotUsed;}
